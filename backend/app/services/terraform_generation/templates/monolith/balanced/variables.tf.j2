variable "project_name" {
  type        = string
  description = "Lowercase project identifier used as resource name prefix."
  validation {
    condition     = can(regex("^[a-z][a-z0-9-]{0,31}$", var.project_name))
    error_message = "project_name must start with a letter, use only [a-z0-9-], and be at most 32 characters (ALB/RDS naming compliance)."
  }
}

variable "environment" {
  type        = string
  description = "Deployment environment (dev|staging|prod)."
  default     = "dev"
}

variable "aws_region" {
  type        = string
  description = "AWS region for all regional resources."
}

variable "strategy_tier" {
  type        = string
  description = "Cost/availability tier driving sizing decisions."
  validation {
    condition     = contains(["low_cost", "balanced", "high_performance"], var.strategy_tier)
    error_message = "strategy_tier must be one of: low_cost, balanced, high_performance."
  }
}

variable "vpc_cidr" {
  type        = string
  description = "CIDR block for the VPC."
}

variable "public_subnet_cidrs" {
  type        = list(string)
  description = "CIDR blocks for public subnets (one per AZ)."
}

variable "private_subnet_cidrs" {
  type        = list(string)
  description = "CIDR blocks for private subnets (one per AZ)."
}

variable "container_image" {
  type        = string
  description = "Container image URI (set after Docker build pushes to ECR)."
  default     = "public.ecr.aws/nginx/nginx:stable"
}

variable "container_port" {
  type        = number
  description = "Port the application listens on inside the container."
}

variable "desired_count" {
  type        = number
  description = "Desired ECS task count."
}

{% if enable_rds %}
variable "db_engine" {
  type        = string
  description = "RDS engine identifier."
}

variable "db_instance_class" {
  type        = string
  description = "RDS instance class."
}

variable "db_multi_az" {
  type        = bool
  description = "Whether to deploy the database Multi-AZ."
}

variable "db_password" {
  type        = string
  description = "Master DB password — inject via secret at apply time."
  sensitive   = true
  default     = "CHANGE_ME_AT_APPLY"
}
{% endif %}
