# Continuous delivery workflow generated by the DevSecOps AI Platform.
# Target: Amazon EC2 - test, build the image, push to ECR, then pull and run it
# on the instances Terraform tagged with Project=<< project_name >> via SSM.
#
# Runs on every push to main. It performs application delivery ONLY: it never
# runs Terraform. Infrastructure is provisioned ONCE by the companion
# bootstrap.yml; this workflow assumes the EC2 instances already exist.
#
# Source of truth: this template. The image is built from << dockerfile_path >>.
name: Deploy << project_name >> to EC2

on:
  push:
    branches:
      - main
  workflow_dispatch:

permissions:
  contents: read

# Serialize deployments — a newer push supersedes an in-flight one.
concurrency:
  group: deployment
  cancel-in-progress: true

env:
  AWS_REGION: << aws_region >>
  ECR_REPOSITORY: << repository_name >>
  PROJECT_TAG: << project_name >>
  CONTAINER_PORT: "<< container_port >>"
  IMAGE_TAG: ${{ github.sha }}

jobs:
  deploy:
    name: Test, build and deploy
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Run tests
        # Auto-detect the project toolchain from well-known marker files and run
        # its test command. Non-blocking (continue-on-error) so a project without
        # a test suite still delivers. Detection order matters: Angular before the
        # generic Node check (an Angular repo also has package.json).
        continue-on-error: true
        run: |
          if [ -f pom.xml ]; then
            echo "Detected Maven (Spring Boot) project — running 'mvn test'"
            mvn -B test
          elif [ -f build.gradle ] || [ -f build.gradle.kts ]; then
            echo "Detected Gradle project — running 'gradle test'"
            ./gradlew test || gradle test
          elif [ -f angular.json ]; then
            echo "Detected Angular project — running 'npm test --watch=false'"
            npm ci
            npm test -- --watch=false
          elif [ -f package.json ]; then
            echo "Detected Node project — running 'npm test'"
            npm ci
            npm test
          elif [ -f pyproject.toml ] || [ -f requirements.txt ] || [ -f setup.py ]; then
            echo "Detected Python project — running 'pytest'"
            pip install -r requirements.txt 2>/dev/null || true
            pytest
          else
            echo "No recognised test toolchain found — skipping tests"
          fi

      - name: Configure AWS credentials
        uses: aws-actions/configure-aws-credentials@v4
        with:
          aws-access-key-id: ${{ secrets.AWS_ACCESS_KEY_ID }}
          aws-secret-access-key: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
          aws-region: ${{ env.AWS_REGION }}

      - name: Log in to Amazon ECR
        id: login-ecr
        uses: aws-actions/amazon-ecr-login@v2

      - name: Build, tag and push image to Amazon ECR
        env:
          ECR_REGISTRY: ${{ steps.login-ecr.outputs.registry }}
        run: |
          docker build -t "$ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG" -f << dockerfile_path >> .
          docker push "$ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG"

      - name: Deploy to Amazon EC2 via SSM
        # Targets instances by the Project tag Terraform applies, so no instance
        # IDs are hardcoded. Each instance logs in to ECR, pulls the new image and
        # restarts the container.
        env:
          ECR_REGISTRY: ${{ steps.login-ecr.outputs.registry }}
        run: |
          aws ssm send-command \
            --region "$AWS_REGION" \
            --document-name "AWS-RunShellScript" \
            --targets "Key=tag:Project,Values=$PROJECT_TAG" \
            --comment "Deploy $PROJECT_TAG $IMAGE_TAG" \
            --parameters commands="[\
              \"aws ecr get-login-password --region $AWS_REGION | docker login --username AWS --password-stdin $ECR_REGISTRY\",\
              \"docker pull $ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG\",\
              \"docker rm -f $PROJECT_TAG || true\",\
              \"docker run -d --restart unless-stopped --name $PROJECT_TAG -p $CONTAINER_PORT:$CONTAINER_PORT $ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG\"\
            ]"
