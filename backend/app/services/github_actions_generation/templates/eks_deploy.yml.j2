# Deployment workflow generated by the DevSecOps AI Platform.
# Target: Amazon EKS - build image, push to ECR, roll the Kubernetes deployment.
# Source of truth: this template. Infrastructure is provisioned by the
# Terraform under << terraform_directory >>/ and the image is built from
# << dockerfile_path >>.
name: Deploy << project_name >> to EKS

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read

env:
  AWS_REGION: << aws_region >>
  ECR_REPOSITORY: << repository_name >>
  EKS_CLUSTER: << cluster_name >>
  K8S_DEPLOYMENT: << project_name >>
  TERRAFORM_DIR: << terraform_directory >>
  IMAGE_TAG: ${{ github.sha }}

jobs:
  deploy:
    name: Build, provision and deploy
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Configure AWS credentials
        uses: aws-actions/configure-aws-credentials@v4
        with:
          aws-access-key-id: ${{ secrets.AWS_ACCESS_KEY_ID }}
          aws-secret-access-key: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
          aws-region: ${{ env.AWS_REGION }}

      - name: Set up Terraform
        uses: hashicorp/setup-terraform@v3

      - name: Terraform init
        working-directory: ${{ env.TERRAFORM_DIR }}
        run: terraform init -input=false

      - name: Terraform apply
        working-directory: ${{ env.TERRAFORM_DIR }}
        run: terraform apply -auto-approve -input=false

      - name: Log in to Amazon ECR
        id: login-ecr
        uses: aws-actions/amazon-ecr-login@v2

      - name: Build, tag and push image to Amazon ECR
        env:
          ECR_REGISTRY: ${{ steps.login-ecr.outputs.registry }}
        run: |
          docker build -t "$ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG" -f << dockerfile_path >> .
          docker push "$ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG"

      - name: Update kubeconfig
        run: aws eks update-kubeconfig --name "$EKS_CLUSTER" --region "$AWS_REGION"

      - name: Deploy to Amazon EKS
        # Applies manifests under k8s/ when present, then rolls the deployment to
        # the freshly pushed image and waits for the rollout to complete.
        env:
          ECR_REGISTRY: ${{ steps.login-ecr.outputs.registry }}
        run: |
          if [ -d k8s ]; then kubectl apply -f k8s/; fi
          kubectl set image "deployment/$K8S_DEPLOYMENT" \
            "$K8S_DEPLOYMENT=$ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG"
          kubectl rollout status "deployment/$K8S_DEPLOYMENT" --timeout=300s
