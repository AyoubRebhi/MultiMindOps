# Bootstrap (infrastructure) workflow generated by the DevSecOps AI Platform.
# Target: AWS Lambda (container image) - provision infrastructure with Terraform,
# build the image, push it to ECR and perform the FIRST function deployment.
#
# Run this ONCE (manually) to stand the environment up. Continuous delivery on
# every push is handled by the separate deploy.yml — this workflow is NOT push
# triggered so application changes never re-run `terraform apply`.
#
# Source of truth: this template. Infrastructure is provisioned by the Terraform
# under << terraform_directory >>/ and the image is built from << dockerfile_path >>.
name: Bootstrap << project_name >> on Lambda

on:
  workflow_dispatch:

permissions:
  contents: read

env:
  AWS_REGION: << aws_region >>
  ECR_REPOSITORY: << repository_name >>
  LAMBDA_FUNCTION: << function_name >>
  TERRAFORM_DIR: << terraform_directory >>
  IMAGE_TAG: ${{ github.sha }}

jobs:
  bootstrap:
    name: Provision and first deploy
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Configure AWS credentials
        uses: aws-actions/configure-aws-credentials@v4
        with:
          aws-access-key-id: ${{ secrets.AWS_ACCESS_KEY_ID }}
          aws-secret-access-key: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
          aws-region: ${{ env.AWS_REGION }}

      - name: Set up Terraform
        uses: hashicorp/setup-terraform@v3

      - name: Terraform init
        working-directory: ${{ env.TERRAFORM_DIR }}
        run: terraform init -input=false

      - name: Terraform apply
        working-directory: ${{ env.TERRAFORM_DIR }}
        run: terraform apply -auto-approve -input=false

      - name: Log in to Amazon ECR
        id: login-ecr
        uses: aws-actions/amazon-ecr-login@v2

      - name: Package and push Lambda image to Amazon ECR
        env:
          ECR_REGISTRY: ${{ steps.login-ecr.outputs.registry }}
        run: |
          docker build -t "$ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG" -f << dockerfile_path >> .
          docker push "$ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG"

      - name: First deployment to AWS Lambda
        # Points the function at the freshly pushed container image and waits for
        # the update to settle before the job succeeds.
        env:
          ECR_REGISTRY: ${{ steps.login-ecr.outputs.registry }}
        run: |
          aws lambda update-function-code \
            --function-name "$LAMBDA_FUNCTION" \
            --image-uri "$ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG" \
            --region "$AWS_REGION"
          aws lambda wait function-updated \
            --function-name "$LAMBDA_FUNCTION" \
            --region "$AWS_REGION"
