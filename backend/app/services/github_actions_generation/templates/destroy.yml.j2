# Infrastructure destruction workflow generated by the DevSecOps AI Platform.
# Tears down ALL AWS resources Terraform provisioned for << project_name >>.
#
# DESTRUCTIVE + IRREVERSIBLE: runs `terraform destroy -auto-approve` against the
# committed Terraform under << terraform_directory >>/. It is target-agnostic —
# destroying the state removes whatever the infrastructure pipeline created (ECS /
# EKS / Lambda / EC2). Triggered manually (workflow_dispatch) and auto-dispatched
# by MultiMinds when an engineer confirms destruction; observed read-only by the
# monitoring surface EXACTLY like bootstrap.yml.
#
# Source of truth: this template. The platform never runs Terraform — GitHub
# Actions is the execution engine.
name: Destroy << project_name >> infrastructure

on:
  workflow_dispatch:

permissions:
  contents: read

# Serialize destroys — never cancel a destroy mid-flight (a half-torn-down state
# is worse than waiting), and let a newer request queue behind the running one.
concurrency:
  group: infrastructure-destroy
  cancel-in-progress: false

env:
  AWS_REGION: << aws_region >>
  TERRAFORM_DIR: << terraform_directory >>

jobs:
  destroy:
    name: Destroy infrastructure
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Configure AWS credentials
        uses: aws-actions/configure-aws-credentials@v4
        with:
          aws-access-key-id: ${{ secrets.AWS_ACCESS_KEY_ID }}
          aws-secret-access-key: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
          aws-region: ${{ env.AWS_REGION }}

      - name: Set up Terraform
        uses: hashicorp/setup-terraform@v3

      - name: Terraform init
        working-directory: ${{ env.TERRAFORM_DIR }}
        run: terraform init -input=false

      - name: Terraform destroy
        working-directory: ${{ env.TERRAFORM_DIR }}
        run: terraform destroy -auto-approve -input=false
